{
  "manifest_version": 3,
  "name": "ChatGPT 提问导航",
  "version": "1.0.0",
  "description": "为 ChatGPT 长对话建立提问目录，点击定位历史问题；支持近期预加载、一键展开与收起。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
